// {{ ansible_managed }}

// opennet acls
acl "internetx" {
  62.116.132.5;    # axfr.domain-robot.org (InternetX AXFR Gateway)
  62.116.129.216;  # mail.domain-robot.org (InternetX AutoDNS Import)
};

// opennet keys
include "/etc/bind/keys/opennet-transfer.key";
include "/etc/bind/keys/opennet-dyndns-aps.key";

// opennet options
options {
  directory "/var/cache/bind";
  dnssec-validation auto;
  listen-on-v6 { any; };
  // opennet
  version "opennet";
  recursion no;
  allow-query { any; };
  allow-transfer { 
    127.0.0.1; 
    key dnskey.opennet;
    internetx;
  };
  key-directory "/etc/bind/keys";
};

// opennet zones
include "/etc/bind/zones.opennet";
